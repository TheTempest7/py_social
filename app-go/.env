JWT_SECRET=super-secret-change-me-in-production
JWT_LIFETIME_HOURS=24
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax
REDIS_ADDR=localhost:6379
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
# Пул соединений
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# --- PostgreSQL ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=myuser
DB_PASSWORD=mypassword
DB_NAME=social_network
DB_SSLMODE=disable

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@social.network

MINIO_MAX_CONCURRENT_REQUESTS=10

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
